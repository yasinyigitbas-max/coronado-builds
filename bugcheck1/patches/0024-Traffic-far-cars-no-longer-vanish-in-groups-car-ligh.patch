From 0fb4449843a21533d98f22caeebe6768bbe21051 Mon Sep 17 00:00:00 2001
From: bugcheck <bugcheck@local>
Date: Sat, 7 Nov 2026 15:50:06 +0000
Subject: [PATCH] Traffic: far cars no longer vanish in groups; car lights end
 with their body

Yasin 7 Nov: car lights persist when the car bodies disappear. lod_bands' small-object cap
(_cap_small: < 12 m -> visibility_range_end 220 m) caught every FarCars_<model>_L<band>
MultiMesh, and Godot measures a MultiMeshInstance's range from the centre of its whole AABB
(all far cars of that model, spread over up to 800 m): groups of distant cars blinked out while
the CarLights batch (camera-centred AABB) kept their coronas. The far-car batches and CarLights
now carry lb_small (distance is per car: traffic v.end = 400 m, buses 640 m), and each car's
lights end at its body's end distance (CarLights.add(.., end), capped at RANGE 420 m).
---
 traffic/traffic.gd     |  6 +++++-
 world_fx/car_lights.gd | 13 +++++++++----
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/traffic/traffic.gd b/traffic/traffic.gd
index 109d0825..e828f1ae 100644
--- a/traffic/traffic.gd
+++ b/traffic/traffic.gd
@@ -507,7 +507,7 @@ func _make_car(c: Dictionary) -> Dictionary:
 		var ln := body.get_node_or_null(nm)
 		if ln: body.remove_child(ln); ln.free()
 	root.add_child(body)
-	CarLights.add(root, CarModels.mesh(id).get_aabb())   # worker-b17int item 2: headlights / tail glows at night (no lights)
+	CarLights.add(root, CarModels.mesh(id).get_aabb(), vis_end)   # worker-b17int item 2: headlights / tail glows at night (no lights)
 	var wheels := []
 	if c.cityride:
 		# overseer-dc-perf4: one shared mesh + material for every roof light (was a new BoxMesh + material per car)
@@ -683,6 +683,10 @@ func _draw_far_cars(eye: Vector3) -> void:
 			var mm := MultiMesh.new(); mm.transform_format = MultiMesh.TRANSFORM_3D; mm.use_colors = true
 			mm.mesh = CarModels.lods(p[0])[int(p[1])]
 			mi = MultiMeshInstance3D.new(); mi.name = "FarCars_" + k.replace(":", "_L"); mi.multimesh = mm
+			# bugcheck1 0024 (Yasin 7 Nov: "car lights persist when their bodies disappear"): lod_bands capped every far-car batch
+			# at its 220 m small-object range, measured from the centre of the WHOLE batch (cars spread over 800 m), so groups of
+			# distant cars vanished while their lights (camera-centred batch) stayed. Distance is per car here (v.end).
+			mi.set_meta(&"lb_small", true)
 			mi.material_override = CarModels.material_far(); mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF   # perf-src2: LOD1 shadow off (draw cut; LOD0 keeps rig shadows)
 			add_child(mi); mi.top_level = true; mi.global_transform = Transform3D.IDENTITY; _far_mm[k] = mi
 		var m := mi.multimesh
diff --git a/world_fx/car_lights.gd b/world_fx/car_lights.gd
index e502bb32..fc6d9789 100644
--- a/world_fx/car_lights.gd
+++ b/world_fx/car_lights.gd
@@ -12,9 +12,12 @@ static var mat: ShaderMaterial
 static var drawn := 0               # instances drawn last tick (tests / perf)
 static var _buf := PackedFloat32Array()
 
-static func add(n: Node3D, bb: AABB) -> void:
-	for c: Array in _cars: if c[0] == n: return
-	_cars.append([n, bb.size.x * 0.5, bb.end.z, bb.position.z])
+## end (bugcheck1 0024): the distance past which this car's BODY is no longer drawn; its lights end there too
+## (traffic rigs: 400 m, buses 640 m, capped at RANGE). Before, every car's lights ran to RANGE (420 m) whatever the body did.
+static func add(n: Node3D, bb: AABB, end := RANGE) -> void:
+	for c: Array in _cars:
+		if c[0] == n: c[4] = minf(end, RANGE); return
+	_cars.append([n, bb.size.x * 0.5, bb.end.z, bb.position.z, minf(end, RANGE)])
 static func remove(n: Node3D) -> void:
 	for i in range(_cars.size() - 1, -1, -1): if _cars[i][0] == n: _cars.remove_at(i)
 
@@ -34,6 +37,7 @@ static func ensure(parent: Node) -> void:
 	mi = MultiMeshInstance3D.new(); mi.name = "CarLights"; mi.multimesh = mm; mi.material_override = mat
 	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
 	mi.custom_aabb = AABB(Vector3(-8000, -50, -2000), Vector3(14000, 300, 12000))
+	mi.set_meta(&"lb_small", true)   # bugcheck1 0024: distance is per car (tick), not lod_bands' 220 m small-object cap
 	parent.add_child(mi); mi.top_level = true; mi.global_transform = Transform3D.IDENTITY
 
 static func tick(night_k: float, eye: Vector3) -> void:
@@ -58,7 +62,8 @@ static func tick(night_k: float, eye: Vector3) -> void:
 		i += 1
 		if not nd.is_inside_tree() or not nd.is_visible_in_tree(): continue
 		var xf := nd.global_transform
-		if xf.origin.distance_squared_to(eye) > r2: continue
+		var ce: float = c[4] if c.size() > 4 else RANGE
+		if xf.origin.distance_squared_to(eye) > minf(r2, ce * ce): continue
 		var fl := (1.0 if nd.get_meta(&"cl_on", true) else 0.0) + (2.0 if nd.get_meta(&"cl_brake", false) else 0.0)
 		if fl < 0.5: continue
 		var o := n * STRIDE; var bs := xf.basis
-- 
2.43.0

