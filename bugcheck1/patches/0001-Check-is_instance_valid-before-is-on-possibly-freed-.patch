From 177ff3cb26eedada87080f0e73b91c02315f15a9 Mon Sep 17 00:00:00 2001
From: bugcheck <bugcheck@local>
Date: Sat, 7 Nov 2026 00:42:55 +0000
Subject: [PATCH 01/10] Check is_instance_valid() before 'is' on possibly-freed
 objects

'x is T and is_instance_valid(x)' raises 'Left operand of is is a previously
freed instance' when x was freed (seen in furniture_layer _trunks_abort/_pkg_off
when a cell package is freed with a pending trunk drain: _pkg_off aborts before
cellmerge.remove_prefix). Swap the order everywhere the pattern appears.
---
 map_dc/coronado/coronado_world.gd               | 2 +-
 map_dc/coronado/furniture/furniture_layer.gd    | 4 ++--
 map_dc/coronado/home/home_flat.gd               | 2 +-
 map_dc/coronado/home/home_layer.gd              | 2 +-
 map_dc/coronado/npc/talk/npc_talk.gd            | 2 +-
 map_dc/coronado/perf/cell_pkg.gd                | 4 ++--
 map_dc/coronado/perf/shadow_policy.gd           | 2 +-
 map_dc/coronado/shops/interior/shop_interior.gd | 4 ++--
 minigames/alien_dreams.gd                       | 2 +-
 player/camera_rig.gd                            | 2 +-
 story/intro/day2_scene.gd                       | 4 ++--
 story/intro/flatmate_scene.gd                   | 4 ++--
 ui/phone/phone_pull.gd                          | 2 +-
 voice/talk_anim.gd                              | 4 ++--
 14 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/map_dc/coronado/coronado_world.gd b/map_dc/coronado/coronado_world.gd
index 5e1b3964..2d05029b 100644
--- a/map_dc/coronado/coronado_world.gd
+++ b/map_dc/coronado/coronado_world.gd
@@ -719,7 +719,7 @@ func _pkg_in_flight(k: Vector2i) -> bool:
 	# (wants()) - a cell behind the player is not loading now, but it loads when they turn / drive that way, so its
 	# terrain must wait (no runtime terrain build for geometry nobody looks at, and no 8 s PKGWAIT fallback either)
 	if buildings.has_method(&"wants"): return not bool(buildings.call(&"wants", k))
-	if tg is Node3D and is_instance_valid(tg) and &"r_bld" in buildings:
+	if is_instance_valid(tg) and tg is Node3D and &"r_bld" in buildings:
 		var c := Vector2((k.x + 0.5) * 100.0, (k.y + 0.5) * 100.0)
 		var tp := (tg as Node3D).global_position
 		if c.distance_to(Vector2(tp.x, tp.z)) > float(buildings.get(&"r_bld")) + 100.0: return true
diff --git a/map_dc/coronado/furniture/furniture_layer.gd b/map_dc/coronado/furniture/furniture_layer.gd
index f79bd3cc..5ac6090c 100644
--- a/map_dc/coronado/furniture/furniture_layer.gd
+++ b/map_dc/coronado/furniture/furniture_layer.gd
@@ -438,7 +438,7 @@ func _pkg_on(k: Vector2i, fp: Node3D) -> void:
 	AP.end(ap)
 ## visual-src5: remove the trunk shape owners of an unfinished drain of this package part (ids in body meta "trunk_so")
 func _trunks_abort(fp: Variant) -> void:
-	if not (fp is Node3D and is_instance_valid(fp)): return
+	if not (is_instance_valid(fp) and fp is Node3D): return
 	var body := (fp as Node3D).get_node_or_null(^"colliders") as StaticBody3D
 	if body == null or body.has_meta(&"trunks"): return
 	for so in body.get_meta(&"trunk_so", []):
@@ -454,7 +454,7 @@ func _pkg_off(k: Vector2i) -> void:
 			if job[0] != k: kept.append(job)
 			else: _trunks_abort(job[1])   # visual-src5: a cancelled half-drained cell must not count as done
 		_trunk_q = kept
-	if fp is Node3D and is_instance_valid(fp): _brk_strip(fp)
+	if is_instance_valid(fp) and fp is Node3D: _brk_strip(fp)
 	if cellmerge: cellmerge.remove_prefix("furn_%d_%d/" % [k.x, k.y])
 func _brk_strip(fp: Node3D) -> void:
 	var B := fp.get_node_or_null(^"breakables")
