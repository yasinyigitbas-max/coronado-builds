+## bugcheck1 0017: indices of the group's buildings whose footprint holds a live shop room's door point
+func _occ_skip(G: Dictionary, holes: Array) -> PackedInt32Array:
+	var out := PackedInt32Array()
+	if holes.is_empty(): return out
+	if not G.has("bb"):
+		var bb := Rect2(); var first := true
+		for b: Array in G.data:
+			for i in range(2, b.size(), 2):
+				var q := Vector2(b[i], b[i + 1])
+				if first: bb = Rect2(q, Vector2.ZERO); first = false
+				else: bb = bb.expand(q)
+		G.bb = bb.grow(1.0)
+	var near := false
+	for h: Vector2 in holes: if (G.bb as Rect2).has_point(h): near = true; break
+	if not near: return out
+	for j in (G.data as Array).size():
+		var b: Array = G.data[j]; var pts := PackedVector2Array()
+		for i in range(2, b.size(), 2): pts.append(Vector2(b[i], b[i + 1]))
+		for h: Vector2 in holes:
+			if Geometry2D.is_point_in_polygon(h, pts): out.append(j); break
+	return out
