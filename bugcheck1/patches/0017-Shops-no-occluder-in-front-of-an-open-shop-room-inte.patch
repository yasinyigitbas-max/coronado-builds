+## bugcheck1 0017: live rooms -> CoronadoShopInterior.occ_holes (the occluders in front of them are left out)
+func _occ_holes_step() -> void:
+	var want := {}
+	for k: String in live:
+		var rv: Variant = live[k].get("room")
+		if is_instance_valid(rv) and (rv as Node).is_inside_tree():
+			var d: Vector3 = (rv as CoronadoShopInterior).door_inside()
+			want[k] = Vector2(d.x, d.z)
+	var H: Dictionary = CoronadoShopInterior.occ_holes
+	if want.size() == H.size() and want.keys().all(func(k) -> bool: return H.has(k)): return
+	CoronadoShopInterior.occ_holes = want; CoronadoShopInterior.occ_ver += 1
+	if is_instance_valid(shops) and shops.has_method(&"facade_occluders_refresh"): shops.facade_occluders_refresh()
