+# ---------------------------------------------------------------- lane use (traffic-lanes)
+## Cars are no longer bound to the lane they spawned in: a turn owned by a neighbouring lane is reached by a lane
+## change before the junction (a "folded" connector is the fallback, guarded by the same-approach conflict rule),
+## free-driving cars pass a slow car, every car goes around a held / broken-down one on multi-lane roads, and now
+## and then an ambient car stops at the kerb for a while. Decisions run once per LC_THINK_S per car.
+const LC_THINK_S := 1.0
+const LC_SLIDE_MPS := 1.1     ## sideways speed of the visual slide (m/s, at least)
+const LC_MIN_END := 8.0       ## no lane change closer than this (+ body) to the junction
+const FOLD_COST := 25.0       ## route cost of a lane change (m)
+const PARK_P := 0.004         ## chance per think tick on an eligible lane (~1 stop / 4 min of driving there)
+var lane_logic := true
+var _sib_cache := {}
+var _right_cache := {}
+func _sibs(key: String) -> Array:
+	if _sib_cache.has(key): return _sib_cache[key]
+	var out := []
+	if not key.begins_with("c|"):
+		var pl := RoadsAPI.parse_lane(key)
+		for k in R.edge_lanes(pl[0], pl[1]):
+			if k != key and is_drivable(k): out.append(k)
+	_sib_cache[key] = out
+	return out
+
+## sideways offset of q from piece P at s, + = right of travel
+static func _lat_of(P: Dictionary, s: float, q: Vector3) -> float:
+	var r := sample(P, s); var f: Vector3 = r[1]
+	return Vector3(-f.z, 0.0, f.x).normalized().dot(q - (r[0] as Vector3))
+
+func _is_rightmost(key: String) -> bool:
+	if _right_cache.has(key): return _right_cache[key]
+	var P := piece(key); var sm: float = float(P.len) * 0.5; var ok := true
+	for sib in _sibs(key):
+		var Q := piece(sib)
+		if _lat_of(P, sm, sample(Q, float(Q.len) * 0.5)[0]) > 0.5: ok = false
+	_right_cache[key] = ok
+	return ok
+
+func _lc_gap_ok(car: Dictionary, to_key: String, s2: float) -> bool:
+	var P2 := piece(to_key)
+	if s2 < car.len or s2 > float(P2.len) - (car.len + LC_MIN_END): return false
+	for o in _occ.get(to_key, []):
+		if o == car: continue
+		var ds: float = float(o.s) - s2
+		var need: float = (car.len + float(o.len)) * 0.5
+		if ds >= 0.0: need += maxf(4.0, car.v * 0.8)
+		else: need += maxf(5.0, float(o.v) * 1.2 + maxf(0.0, float(o.v) - car.v) * 1.5)
+		if absf(ds) < need: return false
+	return true
+
+## move the car into a sibling lane of the same approach, keeping its world position (the body slides over via lat)
+func _change_lane(car: Dictionary, to_key: String) -> bool:
+	if car.res != -1 or car.res_piece != "" or car.hold or not car.goal.is_empty() or not car.bus.is_empty(): return false
+	var P := piece(car.path[car.pi])
+	if P.kind != "lane" or car.s > float(P.len) - (car.len + LC_MIN_END): return false
+	if absi(int(RoadsAPI.parse_lane(to_key)[2]) - int(P.idx)) != 1: return false   # one lane at a time
+	var P2 := piece(to_key)
+	var s2 := _project(P2, car.pos)
+	if not _lc_gap_ok(car, to_key, s2): return false
+	var nxt: Dictionary = piece(car.path[car.pi + 1]) if car.pi + 1 < car.path.size() else {}
+	var keep: bool = not nxt.is_empty() and nxt.kind == "conn" and nxt.has("owner")   # keep the chosen turn
+	if car.fixed_path and not keep: return false   # a routed car only changes lane for its route
+	var old_pos: Vector3 = car.pos
+	_lc_done(car)
+	_occ_del(car)
+	var tail: Array = car.path.slice(car.pi + 2) if keep else []
+	car.path.resize(car.pi + 1)
+	car.path[car.pi] = to_key
+	if keep:
+		var NC := conn_piece(to_key, str(nxt.to), str(nxt.turn), int(nxt.node))
+		if str(nxt.owner) != to_key: NC.owner = nxt.owner   # still one lane to go
+		car.path.append(NC.key)
+		car.path.append_array(tail)
+	car.s = s2
+	_occ_add(car)
+	if not _occ.has(P.key): _occ[P.key] = []
+	_occ[P.key].append(car); car.lc_from = P.key   # still an obstacle in the old lane until the body has left it
+	car.erase("gkey")
+	if not car.fixed_path: _extend(car)
+	car.lat = clampf(_lat_of(P2, s2, old_pos), -4.5, 4.5); car.lat_to = 0.0
+	_update_pose(car)
+	stats.lane_changes = int(stats.get("lane_changes", 0)) + 1
+	return true
+
+## ambient: drop the planned (folded) turn, continue with a turn the current lane really has
+func _skip_turn(car: Dictionary) -> void:
+	car.path.resize(car.pi + 1)
+	lane_logic = false; _extend(car); lane_logic = true
+	car.erase("gkey"); car.lc_need = false
+	stats.missed_turns = int(stats.get("missed_turns", 0)) + 1
+
+## the body has left the old lane (or the car moved on / was removed): drop its shadow entry there
+func _lc_done(car: Dictionary) -> void:
+	if car.has("lc_from"):
+		var lst: Array = _occ.get(str(car.lc_from), [])
+		lst.erase(car)
+		car.erase("lc_from")
+
+func _lane_think(car: Dictionary) -> void:
+	if car.hold or not car.goal.is_empty(): return
+	var P := piece(car.path[car.pi])
+	if P.kind != "lane": return
+	if car.res != -1:
+		# already booked the junction: an ambient car still in the wrong lane for a folded turn gives the booking back
+		# and takes a turn its own lane has (it never crosses the neighbour lane inside the box)
+		if not car.fixed_path and car.pi + 1 < car.path.size() and piece(car.path[car.pi + 1]).has("owner") and car.res_piece == car.path[car.pi + 1]:
+			_release(car); _skip_turn(car)
+		return
+	# 1) the next turn belongs to a neighbouring lane: get into it before the junction (checked 4x as often meanwhile)
+	car.lc_need = false
+	if car.pi + 1 < car.path.size():
+		var C := piece(car.path[car.pi + 1])
+		if C.kind == "conn" and C.has("owner"):
+			car.lc_need = true
+			var oi: int = int(RoadsAPI.parse_lane(str(C.owner))[2]); var me: int = int(P.idx)
+			var step_k := RoadsAPI.lane_key(int(P.edge), str(P.dir), me + signi(oi - me))
+			if _change_lane(car, step_k): stats.turn_lane_changes = int(stats.get("turn_lane_changes", 0)) + 1
+			elif not car.fixed_path and car.s > float(P.len) - (car.len + LC_MIN_END + 6.0):
+				# too late to get over: an ambient driver skips that turn and takes one its own lane allows (crossing the
+				# neighbour lane inside the box made mutual footprint-guard locks)
+				_skip_turn(car)
+			return
+	if car.fixed_path or car.scripted or car.cityride or int(P.get("lanes", 1)) < 2: return
+	# 2) pass a slow free-driving car, or go around a held / broken-down one (not a queue at a light or junction)
+	var ld = car.get("lead")
+	if ld is Dictionary and not ld.get("_gone", false) and float(car.get("ob_gap", INF)) < 35.0:
+		var vdes: float = float(P.vmax) * float(car.vk)
+		var lw := str(ld.get("why", ""))
+		var parked: bool = ld.hold or lw in ["goal", "bus_stop", "dead_end"] or float(ld.get("stuck_t", 0.0)) > 12.0
+		var slow: bool = lw == "" and float(ld.v) < vdes * 0.65 and car.v < vdes * 0.8
+		if parked or slow:
+			var best_k := ""; var best_room: float = float(car.ob_gap) + 8.0
+			for sib in _sibs(P.key):
+				if absi(int(RoadsAPI.parse_lane(sib)[2]) - int(P.idx)) != 1: continue
+				var P2 := piece(sib); var s2 := _project(P2, car.pos)
+				var room: float = float(P2.len) - s2
+				for o in _occ.get(sib, []): if float(o.s) > s2: room = minf(room, float(o.s) - s2)
+				if room > best_room: best_room = room; best_k = sib
+			if best_k != "" and _change_lane(car, best_k):
+				stats.overtakes = int(stats.get("overtakes", 0)) + 1
+				return
+	# 3) now and then: a short stop at the kerb (rightmost lane of a multi-lane road, so others can pass)
+	if car.v > 3.0 and rng.randf() < PARK_P and _is_rightmost(P.key):
+		var at: float = car.s + 25.0 + car.v * 2.0
+		if car.s > 10.0 and at < float(P.len) - 12.0 and P.cross.is_empty():
+			car.goal = [car.pi, at]; car.lat_to = 1.2; car.arrived = false
+			car.park = rng.randf_range(12.0, 40.0)
+			stats.parks = int(stats.get("parks", 0)) + 1
