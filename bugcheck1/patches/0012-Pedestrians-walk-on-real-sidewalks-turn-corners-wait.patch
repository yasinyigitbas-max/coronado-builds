-			for n in [e.a, e.b]:
-				if not _node_edges.has(n): _node_edges[n] = []
-				_node_edges[n].append(i)
+		# bugcheck peds: the same junction table with INT keys. JSON node ids are floats and every lookup (setback(),
+		# _ped_turn) passes an int, so _node_all never matched: every junction set-back was 0 and walkers found no street
+		# to turn into at any corner (they turned back). Cars keep the old table (their junction logic is tuned to it;
