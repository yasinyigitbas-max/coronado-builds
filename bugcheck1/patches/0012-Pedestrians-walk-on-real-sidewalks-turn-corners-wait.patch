+## bugcheck peds: set-back from the int-keyed table (the real junction size)
+func _ped_setback(eid: int, node: int) -> float: return _setback_in(_node_all_i, eid, node)
+func _setback_in(tab: Dictionary, eid: int, node: int) -> float:
