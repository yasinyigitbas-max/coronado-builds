 		if sig == -1: pd.xnode = -1; pd.xsig = false; pd.xjunction = node
-		var xs := maxf(setback(pd.edge, node) - 1.5, 3.0)   # crosswalk in the junction mouth, ahead of the stop bar
+		var xs := _corner_s(pd.edge, node)   # crosswalk in the junction mouth, ahead of the stop bar
 		var L: float = edge_piece(pd.edge).len
 		pd.s = clampf(xs if pd.dirn < 0 else L - xs, 2.0, L - 2.0)
 		pd.after = "turn"
@@ -1400,27 +1456,32 @@ func _ped_turn(pd: Dictionary) -> void:
 	var opts: Array = []
 	for x in _node_edges.get(node, []):
 		if x != pd.edge: opts.append(x)
-	if opts.is_empty():
-		pd.dirn = -pd.dirn; return
