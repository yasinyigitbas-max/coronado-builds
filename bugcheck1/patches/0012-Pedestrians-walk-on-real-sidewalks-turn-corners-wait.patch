-	pd.state = "turn"
+	# bugcheck peds: try the streets in random order; take the first whose sidewalk corner is reachable without walking
+	# through a carriageway (a real sidewalk side, and the straight corner walk doesn't cut across another road)
+	for i in range(opts.size() - 1, 0, -1):
+		var j := rng.randi_range(0, i); var tmp = opts[i]; opts[i] = opts[j]; opts[j] = tmp
+	for ne: int in opts:
+		var E2: Dictionary = R.edges[ne]
+		var P2 := edge_piece(ne)
+		var at_a: bool = E2.a == node
+		var c2: float = minf(_corner_s(ne, node), float(P2.len) * 0.3)   # the new street's sidewalk corner
+		var s2 := c2 if at_a else float(P2.len) - c2
+		var dir2 := 1 if at_a else -1
+		# sidewalk side of the new street nearest to where we stand (turn the corner, no carriageway crossing)
+		var best := INF; var bside := 0
+		for sd in [1, -1]:
+			if not _ped_side_ok(ne, sd): continue
+			var pp := ped_pos({"edge": ne, "s": s2, "lat": _ped_side_off(E2, sd)})
+			var dd := pp.distance_to(pd.pos)
+			if dd < best: best = dd; bside = sd
+		if bside == 0 or best > 30.0: continue
+		var tg := ped_pos({"edge": ne, "s": s2, "lat": _ped_side_off(E2, bside)})
