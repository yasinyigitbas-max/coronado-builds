-	var dir2 := 1 if at_a else -1
-	# sidewalk side of the new street nearest to where we stand (turn the corner, no carriageway crossing)
-	var best := INF; var bside := 1
-	for sd in [1, -1]:
-		var q := {"edge": ne, "s": s2, "lat": _ped_side_off(E2, sd)}
-		var pp := ped_pos(q)
-		var dd := pp.distance_to(pd.pos)
-		if dd < best: best = dd; bside = sd
-	var q2 := {"edge": ne, "s": s2, "lat": _ped_side_off(E2, bside)}
-	pd.target = ped_pos(q2)
-	if best > 30.0:
-		pd.dirn = -pd.dirn; return
