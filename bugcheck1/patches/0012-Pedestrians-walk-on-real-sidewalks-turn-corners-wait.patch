 		"wait_cross":
@@ -1376,6 +1397,41 @@ func _in_car(p: Vector3, m: float, ahead_s := 0.0, stopped_tight := false) -> bo
 func _face(pd: Dictionary, d: Vector3) -> void:
 	if Vector2(d.x, d.z).length() > 1e-4: pd.yaw = atan2(d.x, d.z)
 
+const PED_MIN_WALK := 4.0   ## m of real sidewalk a street piece needs outside its junctions to be walked
+## bugcheck peds: is this side of the street piece a real sidewalk? Not when its walking line lies inside ANOTHER
+## drivable road (the inner side of a dual-carriageway piece = median / opposite carriageway). Cached per piece + side.
+var _side_ok_cache := {}
+func _ped_side_ok(eid: int, side: int) -> bool:
+	var k := eid * 2 + (1 if side > 0 else 0)
+	if _side_ok_cache.has(k): return _side_ok_cache[k]
+	var e: Dictionary = R.edges[eid]; var L: float = edge_piece(eid).len
+	var ok := true
+	for f in [0.25, 0.5, 0.75]:
+		var q := ped_pos({"edge": eid, "s": L * f, "lat": _ped_side_off(e, side)})
+		var r := R.road_at(q.x, q.z, 25.0)
+		if not r.is_empty() and int(r.edge) != eid and _drive_ok.get(int(r.edge), false) and float(r.dist) < float(r.get("width", 0.0)) * 0.5 - 0.3:
+			ok = false; break
+	_side_ok_cache[k] = ok
+	return ok
+
+## bugcheck peds: would walking straight from a to b cut through a carriageway other than these streets?
+func _ped_walk_crosses_road(a: Vector3, b: Vector3, own: Array) -> bool:
+	for f in [0.25, 0.5, 0.75]:
+		var q := a.lerp(b, f)
+		var r := R.road_at(q.x, q.z, 25.0)
+		if r.is_empty() or own.has(int(r.edge)) or not _drive_ok.get(int(r.edge), false): continue
+		if float(r.dist) < float(r.get("width", 0.0)) * 0.5 - 0.3 and float(r.get("width", 0.0)) > 7.0: return true   # alley / driveway mouths (<= 7 m) are walked across
+	return false
+
+## bugcheck peds: distance from the node at which this street's sidewalk meets the cross street's kerb (cached)
+var _corner_cache := {}
+func _corner_s(eid: int, node: int) -> float:
+	var k := eid * 1000003 + node
+	if _corner_cache.has(k): return _corner_cache[k]
+	var v := maxf(_ped_setback(eid, node) - 1.5, 3.0)
+	_corner_cache[k] = v
+	return v
+
 func _ped_at_corner(pd: Dictionary) -> void:
 	var e: Dictionary = R.edges[pd.edge]
 	var node: int = e.b if pd.dirn > 0 else e.a
