 						pd.xsig = cc[1].tags.get("crossing", "") == "traffic_signals"; pd.xnode = -1
 			var end_s := 0.0 if pd.dirn < 0 else float(P.len)
-			var cz: float = minf(4.0, float(P.len) * 0.3)   # corner zone: on a short edge both 4 m zones overlapped -> flip every frame, frozen walker
+			# bugcheck peds: the corner is where the CROSS street's kerb is (junction set-back), not a flat 4 m from the node
