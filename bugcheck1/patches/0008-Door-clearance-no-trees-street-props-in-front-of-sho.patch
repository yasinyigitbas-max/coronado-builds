diff --git a/map_dc/coronado/furniture/door_clear.gd b/map_dc/coronado/furniture/door_clear.gd
new file mode 100644
index 00000000..b1546600
--- /dev/null
+++ b/map_dc/coronado/furniture/door_clear.gd
@@ -0,0 +1,40 @@
+## Door clearance (bugcheck 2026-11-07): the space in front of every shop / vacant-unit door is kept free of street
+## furniture and trees. Used by CoronadoFurniture right after its rows are loaded, so the runtime build, the furniture
+## chunk bakes and the cell packages (tools/gray_bake) all get the same rows. Doors are computed exactly like
+## CoronadoShops does at runtime (_init_head: reversed facade edges flipped, separate_fronts) + the walk-in door
+## offset used by the shops layer / tests/minion/_boot.gd door_frame (u = w / 2 - 0.55, plaque = centre).
+## Found by tests/minion/test_prop_collision.gd DOORWAYS: 10 doors blocked (5 by props, 5 by tree trunks).
+extends RefCounted   ## preloaded by furniture_layer.gd as DoorClear (no global class: no cache step needed)
+
+const VERSION := 1
+const HALF_W := 0.8   ## half width along the facade (door ~1.1 m + margin)
+const DEPTH := 2.0    ## metres kept clear outward from the facade
+const KEEP := ["manhole"]   ## flush with the ground: walkable, never a blocker
+
+## [[centre: Vector2, along: Vector2, out: Vector2], ...] for every front / vacant unit that has a door
+static func rects() -> Array:
+	var j: Variant = JSON.parse_string(FileAccess.get_file_as_string(CoronadoShops.DATA)) if FileAccess.file_exists(CoronadoShops.DATA) else null
+	if not (j is Dictionary): return []
+	var fronts: Array = ((j as Dictionary).get("fronts", []) as Array).filter(func(f: Dictionary) -> bool: return not CoronadoShops.EXCLUDED.has(str(f.get("key", ""))))
+	var all: Array = fronts + ((j as Dictionary).get("vacant", []) as Array)
+	for f: Dictionary in all:   # same flip as CoronadoShops._init_head (sign art along a->b = street viewer's right)
+		if f.has("ax") and (float(f.bx) - float(f.ax)) * float(f.nz) - (float(f.bz) - float(f.az)) * float(f.nx) < 0.0:
+			var ax: float = f.ax; var az: float = f.az; f.ax = f.bx; f.az = f.bz; f.bx = ax; f.bz = az
+	CoronadoShops.separate_fronts(all)
+	var out := []
+	for f: Dictionary in all:
+		if not (f.get("uv", {}) as Dictionary).get("door") or not f.has("ax"): continue
+		var fr: Dictionary = CoronadoShops.front_frame(f)
+		var t: Vector2 = fr.t; var n: Vector2 = fr.n
+		var u := 0.0 if str(f.get("kind", "")) == "plaque" else float(f.w) * 0.5 - 0.55
+		out.append([(fr.c as Vector2) + t * u, t, n])
+	return out
+
+## true when a footprint circle (p, radius) reaches into one of the rects
+static func blocks(rs: Array, p: Vector2, radius: float) -> bool:
+	for r: Array in rs:
+		var d: Vector2 = p - (r[0] as Vector2)
+		if d.length_squared() > (DEPTH + HALF_W + radius + 1.0) * (DEPTH + HALF_W + radius + 1.0): continue
+		var a := d.dot(r[1]); var b := d.dot(r[2])
+		if absf(a) < HALF_W + radius and b > -radius and b < DEPTH + radius: return true
+	return false
diff --git a/map_dc/coronado/furniture/furniture_layer.gd b/map_dc/coronado/furniture/furniture_layer.gd
index 881c12eb..ad2134bb 100644
