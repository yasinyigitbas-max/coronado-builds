+++ b/map_dc/coronado/furniture/furniture_layer.gd
@@ -1199,7 +1199,32 @@ func tree_place_sig(path: String, keep_palms: Array) -> int:
 	for p: String in PLACE_DEPS: parts.append(FileAccess.get_md5(p) if FileAccess.file_exists(p) else "-")
 	return Baked.sig_of(parts)
 
+## worker thread (black-dc-perffix2): trees.json rows, then the door clearance over ALL rows (props + trees)
 func _load_trees_json() -> void:
+	_load_trees_rows()
+	_door_clear()
+
+## bugcheck 2026-11-07: drop street furniture / trees standing in front of a shop door (CoronadoDoorClear). Same rows for
+## the runtime build, the furniture chunk bakes and the cell packages, so a re-bake removes the baked blockers too.
+const DoorClear := preload("res://map_dc/coronado/furniture/door_clear.gd")
+var door_cleared := 0
+func _door_clear() -> void:
+	var rs := DoorClear.rects()
+	if rs.is_empty(): return
+	var n := 0
+	for k: Vector2i in data:
+		var kept := []
+		for r: Array in data[k]:
+			var t: String = types[int(r[0])]
+			if not t in DoorClear.KEEP:
+				var rad: float = FOOT.get("tree" if t.begins_with("tree") else t, 0.3)
+				if DoorClear.blocks(rs, Vector2(float(r[1]), float(r[3])), rad): n += 1; continue
+			kept.append(r)
+		data[k] = kept
+	door_cleared = n
+	print("CoronadoFurniture: %d props / trees removed from %d door fronts (door clearance v%d)" % [n, rs.size(), DoorClear.VERSION])
+
+func _load_trees_rows() -> void:
 	var path := ""
 	for p: String in TREES_JSONS:
 		if FileAccess.file_exists(p): path = p; break
