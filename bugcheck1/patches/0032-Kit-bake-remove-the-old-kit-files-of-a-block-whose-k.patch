From b4f29e4eb17fbb69d0a9071ab1bff62257efdc62 Mon Sep 17 00:00:00 2001
From: bugcheck <bugcheck@local>
Date: Sat, 7 Nov 2026 17:19:20 +0000
Subject: [PATCH] Kit bake: remove the old kit files of a block whose kit is
 now empty

With 0029/0031 some blocks (14 of 284) had only roof edges / window trim; their new
kit is empty, so bake_kit wrote nothing and the OLD kit_/kitn_ files stayed (and were
packed into the cell packages): the removed frames would still show there.
bake_kit now deletes kit_X_Z.scn / kitn_X_Z.scn when the chunk builds no kit meshes
(stats: stale_removed 28). kit_manifest --verify=12: 0 mismatches (was 2).
Missed cell -16_38 added to KIT_CHANGED_CELLS_0029_0031.txt.
---
 map_dc/coronado/bldg_tex/facade/tools/bake_kit.gd | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/map_dc/coronado/bldg_tex/facade/tools/bake_kit.gd b/map_dc/coronado/bldg_tex/facade/tools/bake_kit.gd
index b84f6f44..165a2fab 100644
--- a/map_dc/coronado/bldg_tex/facade/tools/bake_kit.gd
+++ b/map_dc/coronado/bldg_tex/facade/tools/bake_kit.gd
@@ -40,6 +40,10 @@ func _bake_all() -> void:
 				var out := PackedScene.new(); out.pack(rr)
 				ResourceSaver.save(out, KIT_OUT + pr[1] + id + ".scn", ResourceSaver.FLAG_COMPRESS)
 			tot.chunks += 1; tot.blocks += r.meshes; tot.tris += r.tris
+		else:   # bugcheck1 0032: a chunk whose kit is now empty (e.g. only window trim / roof edges, 0029/0031) must drop its old files, else the stale kit keeps rendering
+			var id0 := f.get_basename().trim_prefix("blk_")
+			for pre in ["kit_", "kitn_"]:
+				if FileAccess.file_exists(KIT_OUT + pre + id0 + ".scn"): DirAccess.remove_absolute(ProjectSettings.globalize_path(KIT_OUT + pre + id0 + ".scn")); tot["stale_removed"] = tot.get("stale_removed", 0) + 1
 		root.free(); nroot.free()
 	if part != 0:
 		var fp := FileAccess.open(ProjectSettings.globalize_path(KIT_OUT + "bake_stats_%d.json" % part), FileAccess.WRITE); fp.store_string(JSON.stringify(tot)); fp.close()
-- 
