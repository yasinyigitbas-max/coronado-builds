diff --git a/vehicles/car_models.gd b/vehicles/car_models.gd
index 78d09792..6b21872c 100644
--- a/vehicles/car_models.gd
+++ b/vehicles/car_models.gd
@@ -781,13 +781,47 @@ static func lods(id: String) -> Array:
 	return out
 
 ## generate the chain (used by the bake tool and as a fallback)
+## bugcheck1 0020 (Yasin 7 Nov: "lots of cars have black empty parts"): the far mesh (35-140 m, most traffic) came from
+## decimate(): welded positions + meshoptimizer to FAR_RATIO, which tore holes, dropped the wheels and smeared trim /
+## glass texels over the paint. Now body and each wheel are simplified separately with Godot's import LOD generator
+## (attribute-aware: uv seams and normals kept) and never below their target, then merged.
+const FAR_WHEEL_MIN := 24
+const FAR_BODY_RATIO := 0.2   ## the generator halves per level; ~20-25 % is the last level that keeps the body shape (old FAR_RATIO 0.08 only got there by tearing it)
 static func build_lods(id: String) -> Array:
-	var fm := decimate(mesh_full(id), FAR_RATIO)
+	var f := split_full(id)
+	var parts: Array = [simplify_to(f.body, int(tri_count(f.body) * FAR_BODY_RATIO))]
+	for w: Dictionary in f.wheels:
+		parts.append(_moved(simplify_to(w.mesh, maxi(int(tri_count(w.mesh) * FAR_BODY_RATIO), FAR_WHEEL_MIN)), w.center))
+	var fm := _merge(parts)
 	return [mesh(id), fm, fm, impostor(id)]
 
+## bugcheck1 0020: Godot's ImporterMesh LOD chain (meshoptimizer with attribute error: uv seams / normals / borders kept)
+## of a single-surface mesh; returns the coarsest level that still has >= target_tris triangles (the full mesh if none).
+## Levels below the target are never used: that is where the simplifier starts tearing the body open.
+static func simplify_to(m: Mesh, target_tris: int) -> ArrayMesh:
+	var a0 := m.surface_get_arrays(0)
+	var st := SurfaceTool.new(); st.create_from_arrays(a0)
+	if a0[Mesh.ARRAY_INDEX] == null or (a0[Mesh.ARRAY_INDEX] as PackedInt32Array).is_empty(): st.index()
+	if a0[Mesh.ARRAY_NORMAL] == null: st.generate_normals()
+	var a := st.commit_to_arrays()
+	var best: PackedInt32Array = a[Mesh.ARRAY_INDEX]
+	var im := ImporterMesh.new(); im.add_surface(Mesh.PRIMITIVE_TRIANGLES, a)
+	gen_lods_calls += 1
+	im.generate_lods(25.0, 60.0, [])
+	for l in im.get_surface_lod_count(0):
+		var ix := im.get_surface_lod_indices(0, l)
+		if ix.size() / 3 >= target_tris and ix.size() < best.size(): best = ix
+	var b := a.duplicate(); b[Mesh.ARRAY_INDEX] = best
+	var o := ArrayMesh.new(); o.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, b)
+	o.surface_set_material(0, material()); return o
+
 ## red-dc-carquarter: quarter-quality simplify (from scratch/red/quarter.gd): re-index (vertices with different uvs
 ## stay split, so atlas seams are kept), meshoptimizer down to QUARTER_RATIO of the triangles, smooth normals.
+## bugcheck1 0020: the old path (kept below as quarter_old) smeared dark trim / grille texels over the bonnet and warped
+## panels; Godot's import LOD generator keeps uv seams and normals (simplify_to).
 static func quarter(m: Mesh, ratio := QUARTER_RATIO) -> ArrayMesh:
+	return simplify_to(m, maxi(int(tri_count(m) * ratio), 4))
+static func quarter_old(m: Mesh, ratio := QUARTER_RATIO) -> ArrayMesh:
 	var a := m.surface_get_arrays(0)
 	var full := tri_count(m)
 	var b := []; b.resize(Mesh.ARRAY_MAX)
